#!/bin/bash

######################
### Bypass Options ###
######################
bypass_madgraph=false
bypass_pythia=false
bypass_delphes=false
bypass_preprocessing=false
bypass_train=false

##################################
### Dataset Generation Options ###
##################################
process="U"
generation="inclusive" # inclusive, first, or second hadronic W decay generation
MG_tag="${process}_10M_gen"
num_runs=40
num_events_per_run="250k"
max_cpu_cores=40
seed=12
top_pT_cut=200 # GeV; pT of the hadronic top reconstructed from b j j

######################
### Pythia Options ###
######################
R="1.5"
minJetpT="250"
PY_tag="${process}_10M_R${R/./_}_pT${minJetpT}"

#######################
### Delphes Options ###
#######################
DELPHES_tag="${PY_tag}"
delphes_card_template="delphes_card_ATLAS_top_polarimetry.tcl.template"
delphes_small_r_algorithm="antikt"
delphes_small_r="0.4"
delphes_small_r_jet_ptmin="10.0"
delphes_large_r_algorithm="cambridge"
delphes_large_r="1.5"
delphes_large_r_jet_ptmin="250.0"
delphes_small_r_jet_flavor_dr="0.4"
delphes_small_r_parton_ptmin="1.0"
delphes_small_r_parton_eta_max="2.5"

#############################
### Preprocessing Options ###
#############################
dir_datasets="WS_${PY_tag}/datasets_AllFrame"

########################
### Training Options ###
########################
analysis_type="down"
epochs=60
embed_dim=64
training_tag="_${analysis_type}_${epochs}epoch_${embed_dim}embed"
dir_training="WS_${PY_tag}/training${training_tag}"
