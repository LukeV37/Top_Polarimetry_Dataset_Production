#!/bin/bash

######################
### Bypass Options ###
######################
bypass_madgraph=false
bypass_pythia=false
bypass_delphes=false
bypass_analysis=false

##################################
### Dataset Generation Options ###
##################################
process="U"
generation="inclusive" # inclusive, first, or second hadronic W decay generation
MG_tag="${process}_10M_gen"
num_runs=40
num_events_per_run="250k"
max_cpu_cores=40
seed=12
top_pT_cut=200 # GeV; pT of the hadronic top reconstructed from b j j

######################
### Pythia Options ###
######################
R="1.5"
minJetpT="250"
PY_tag="${process}_10M_R${R/./_}_pT${minJetpT}"

#######################
### Delphes Options ###
#######################
DELPHES_tag="${PY_tag}"
delphes_card_template="delphes_card_ATLAS_top_polarimetry.tcl.template"
delphes_small_r_algorithm="antikt"
delphes_small_r="0.4"
delphes_small_r_jet_ptmin="10.0"
delphes_large_r_algorithm="cambridge"
delphes_large_r="1.5"
delphes_large_r_jet_ptmin="250.0"
delphes_small_r_jet_flavor_dr="0.4"
delphes_small_r_parton_ptmin="1.0"
delphes_small_r_parton_eta_max="2.5"

########################
### Analysis Options ###
########################
# Momentum thresholds are in GeV. run_job.sh passes these to the analysis stage.
ELECTRON_PT_MIN=${ELECTRON_PT_MIN:-30}
ELECTRON_ABS_ETA_MAX=${ELECTRON_ABS_ETA_MAX:-3}
MUON_PT_MIN=${MUON_PT_MIN:-30}
MUON_ABS_ETA_MAX=${MUON_ABS_ETA_MAX:-3}
MET_MIN=${MET_MIN:-30}
LARGE_R_JET_PT_MIN=${LARGE_R_JET_PT_MIN:-250}
LARGE_R_JET_ABS_ETA_MAX=${LARGE_R_JET_ABS_ETA_MAX:-3}
JET_OVERLAP_DR=${JET_OVERLAP_DR:-1.5}
LEPTONIC_B_JET_PT_MIN=${LEPTONIC_B_JET_PT_MIN:-30}
LEPTONIC_B_JET_ABS_ETA_MAX=${LEPTONIC_B_JET_ABS_ETA_MAX:-3}
LEPTON_B_JET_DR_MIN=${LEPTON_B_JET_DR_MIN:-0.3}
LEPTON_B_JET_DR_MAX=${LEPTON_B_JET_DR_MAX:-3.0}
MAX_LARGE_R_CONSTITUENTS=${MAX_LARGE_R_CONSTITUENTS:-100}
MAX_SMALL_R_JETS=${MAX_SMALL_R_JETS:-10}
